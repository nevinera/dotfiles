fixssh () {
	eval `tmux show-env | sed -n 's/^\(SSH_[^=]*\)=\(.*\)/export \1="\2"/p'`
}

## mki
alias mbs="mki build status"
alias mgv="mki gerrit verify"
alias mgs="mki gerrit status"
alias cfg="$HOME/bin/checkout_gerrit_cr"

fbr () {
	local branch
	branch=$(git branch --sort=committerdate | tail -30 | fzf +s +m --tac -e)  && git checkout $(echo "$branch" | sed "s:.* remotes/origin/::" | sed "s:.* ::")
}

source $HOME/co/manage/script/svnmerge_helpers.sh

alias ls_unsynced="git ls-remote origin 'refs/subgit/unsynced/*'"
alias fetch_unsynced="git fetch origin master 'refs/subgit/unsynced/*:refs/remotes/origin/unsynced/*'"

svnr () {
  local orig=`pwd`
  cd ${HOME}/co/manage-released
  svnprep
  script/svn_avail_fast.rb
  echo "Which revision? "
  read revision
  echo "Creating merge patch - cherry-picking changeset..."
  svnm -r ${revision}
  echo "Release? y/n"
  read confirm
  if [[ "$confirm" == "y" || "$confirm" == "" ]]
  then
    echo "Committing release ${revision}..."
    svn commit -F svnmerge-commit-message.txt
  fi
  cd $orig
}

