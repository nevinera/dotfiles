#!/usr/bin/env ruby

require "json"
require "optparse"

options = {
  input: "coverage/coverage.json",
}

OptionParser.new do |opts|
  opts.banner = "Usage: covr [options] PATH [PATH ...]"
  opts.on("-i", "--input FILE", "Input JSON coverage file") { |path| options[:input] = path }
end.parse!

paths = ARGV.dup

class String
  def red;    "\e[31m#{self}\e[0m"; end
  def green;  "\e[32m#{self}\e[0m"; end
  def yellow; "\e[33m#{self}\e[0m"; end
end

text = File.read(options[:input])
data = JSON.parse(text)
coverage = data["coverage"] || raise("No coverage data found")

coverage.each_pair do |file_path, file_coverage|
  matcher = paths.detect { |path| file_path.end_with?(path) || file_path.include?(path) }
  next unless matcher

  short_path = file_path.start_with?(Dir.getwd) ? file_path[Dir.getwd.length + 1..-1] : file_path
  puts "======== #{short_path}  (#{matcher}) ========"

  line_coverage = file_coverage["lines"]
  branch_coverage = file_coverage["branches"]

  total_lines = line_coverage.compact.size
  if total_lines.zero?
    puts ""
    puts "  No lines to cover.".green
  else
    covered_lines = line_coverage.count { |hits| hits && hits > 0 }
    line_coverage_percent = (covered_lines.to_f / total_lines * 100).round(2)
    coverage_string = "  Line Coverage: #{line_coverage_percent}% (#{covered_lines}/#{total_lines})"
    if line_coverage_percent > 99.99
      puts coverage_string.green
    elsif line_coverage_percent > 79.99
      puts coverage_string.yellow
    else
      puts coverage_string.red
    end

    uncovered_lines = line_coverage
      .each_with_index
      .select { |hits, _| hits && hits == 0 }
      .map { |_, line_index| line_index + 1 }
    puts "    Uncovered Lines: #{uncovered_lines.join(', ')}".yellow unless uncovered_lines.empty?
  end

  if file_coverage.key?("branches")
    total_branches = branch_coverage.size
    if file_coverage["branches"].empty?
      puts "  No branches to cover.".green
    else
      covered_branches = branch_coverage.count { |br| br["coverage"] && br["coverage"] > 0 }
      branch_coverage_percent = (covered_branches.to_f / total_branches * 100).round(2)
      coverage_string = "  Branch Coverage: #{branch_coverage_percent}% (#{covered_branches}/#{total_branches})"
      if branch_coverage_percent > 99.99
        puts coverage_string.green
      elsif branch_coverage_percent > 79.99
        puts coverage_string.yellow
      else
        puts coverage_string.red
      end

      uncovered_branches = branch_coverage.select { |br| br["coverage"] == 0 }
      branch_snippets = uncovered_branches.map { |br| "#{br['start_line']}-#{br['end_line']}(#{br['type']})" }
      puts "    Uncovered Branches: #{branch_snippets.join(', ')}".yellow unless branch_snippets.empty?
    end
  end
end
