alias qqr='qq -Xrspec -v'
alias qqs='qq -Xstandardrb -v'
alias qql='qq -Xrubocop -v'
alias qqm='qq -Xmarkdown_lint -v'

lint_staged () {
  git diff --name-only --cached | grep "\.rb$" | xargs -t -d '\n' -n 1000 script/ruby33 bundle exec rubocop --cache=false
}

lint_changed () {
  git diff --diff-filter=d --name-only HEAD | grep "\.rb$" | xargs -t -d '\n' -n 1000 script/ruby33 bundle exec rubocop --cache=false
}

alias lint=lint_staged
alias lc=lint_changed

alias redis_clear='redis-cli flushall'
alias cleardns='sudo discoveryutil udnsflushcaches'
alias dh="du -h -d 1"
alias shuffle="perl -MList::Util=shuffle -e 'print shuffle(<STDIN>);'"
